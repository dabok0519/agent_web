{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "preserve",   // nodenext 는 import 에 .js 확장자를 요구한다. shadcn·ai-elements 파일은 확장자 없이 쓰므로 preserve(번들러 방식). 서버 쪽 .js import 는 그대로 동작
    "target": "esnext",
    "lib": ["esnext", "dom"],   // dom = 브라우저 단어(document·window). src/web/ui 의 .tsx 가 쓴다
    "types": ["node"],
    // '@/…' = src/ui/… . vite.config.ts 의 alias 와 같은 뜻. shadcn·ai-elements 가 쓴다
    "paths": { "@/*": ["./src/ui/*"] },

    // Other Outputs
    "sourceMap": true,
    // "declaration": true,       // tsx 로만 실행하고 emit 하지 않음 + provider 익명 클래스 타입이 d.ts 생성을 막음 (TS4094)
    // "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": false,     // 같은 이유 (prompt-input.tsx 의 배열 인덱스)
    "exactOptionalPropertyTypes": false,   // 가져온 shadcn·ai-elements 파일이 undefined 대입을 써서 끔. 우리 코드는 켜져 있을 때 쓴 그대로라 영향 없음

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
